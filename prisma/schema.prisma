// prisma/schema.prisma
// GodspeedGrader API - User Authentication Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model - Simple authentication
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String   // Argon2 hash - NEVER store plain text
  role      String   @default("user") // user, school, admin
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  sections      Section[]
  students      Student[]
  exams         Exam[]
  scanResults   ScanResult[]
  periods       Period[]
  gradeLevels   GradeLevel[]
  subjects      Subject[]

  @@map("users")
}

// Grade Levels Registry (NEW)
model GradeLevel {
  id            String   @id // Client-generated UUID
  title         String   // e.g., "Grade 9"
  createdBy     String
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  // Relations
  user          User     @relation(fields: [createdBy], references: [email], onDelete: Cascade)
  sections      Section[]
  exams         Exam[]

  @@map("grade_levels")
}

// Subjects Registry (NEW)
model Subject {
  id            String   @id // Client-generated UUID
  title         String   // e.g., "Mathematics"
  createdBy     String
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  // Relations
  user          User     @relation(fields: [createdBy], references: [email], onDelete: Cascade)
  exams         Exam[]

  @@map("subjects")
}

// The Grading Period (NEW)
model Period {
  id            String   @id // Client-generated UUID
  name          String   // e.g., "1st Quarter", "2nd Quarter"
  startDate     DateTime @map("start_date")
  endDate       DateTime @map("end_date")
  createdBy     String
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  // Relations
  user          User     @relation(fields: [createdBy], references: [email], onDelete: Cascade)
  exams         Exam[]
  scanResults   ScanResult[]

  @@map("periods")
}

// Grade Sections (Classes/Groups)
model Section {
  id            String   @id // Client-generated UUID
  gradeLevelId  String?  @map("grade_level_id") // NEW: Link to GradeLevel
  gradeLevel    String   // e.g., "Grade 9" (Legacy/Display)
  sectionName   String   // e.g., "Rizal"
  createdBy     String   // User email who created
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  // Relations
  user          User        @relation(fields: [createdBy], references: [email], onDelete: Cascade)
  gradeLevelRef GradeLevel? @relation(fields: [gradeLevelId], references: [id], onDelete: SetNull)
  students      Student[]
  scanResults   ScanResult[]

  @@unique([gradeLevel, sectionName, createdBy])
  @@index([gradeLevelId])
  @@map("sections")
}

// Students
model Student {
  id            String   @id // Client-generated UUID
  sectionId     String
  fullName      String
  studentNo     String?
  createdBy     String
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  // Relations
  section       Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [createdBy], references: [email], onDelete: Cascade)
  scanResults   ScanResult[]

  @@index([sectionId])
  @@index([createdBy])
  @@map("students")
}

// Exams (Question templates)
model Exam {
  id            String   @id // Client-generated UUID
  periodId      String?  // NEW: Link to grading period
  gradeLevelId  String?  @map("grade_level_id") // NEW: Link to GradeLevel
  subjectId     String?  @map("subject_id")     // NEW: Link to Subject
  gradeLevel    String   // e.g., "Grade 9" (Legacy/Display)
  subject       String   // e.g., "Science"
  title         String   // e.g., "Midterm Exam"
  category      String?  // NEW: WW, PT, or QA
  maxScore      Int?     // NEW: Optional override for itemCount
  itemCount     Int      // Number of questions
  answerKey     String   // JSON string of correct answers
  competencyMap Json?    @map("competency_map") // NEW: itemNumber -> Competency Name
  createdBy     String
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  // Relations
  user          User        @relation(fields: [createdBy], references: [email], onDelete: Cascade)
  period        Period?     @relation(fields: [periodId], references: [id], onDelete: SetNull)
  gradeLevelRef GradeLevel? @relation(fields: [gradeLevelId], references: [id], onDelete: SetNull)
  subjectRef    Subject?    @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  scanResults   ScanResult[]

  @@index([gradeLevel])
  @@index([subject])
  @@index([createdBy])
  @@index([periodId])
  @@index([gradeLevelId])
  @@index([subjectId])
  @@map("exams")
}

// Scan Results (Student grades)
model ScanResult {
  id            String   @id // Client-generated UUID
  examId        String
  studentId     String
  sectionId     String
  periodId      String?  // NEW: For redundancy/quick filtering
  score         Int
  total         Int
  answers       String   // JSON string of student answers
  createdBy     String
  scannedAt     DateTime @default(now()) @map("scanned_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  // Relations
  exam          Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  section       Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [createdBy], references: [email], onDelete: Cascade)
  period        Period?  @relation(fields: [periodId], references: [id], onDelete: SetNull)

  @@unique([examId, studentId])
  @@index([examId])
  @@index([studentId])
  @@index([sectionId])
  @@index([createdBy])
  @@index([periodId])
  @@map("scan_results")
}